# Скопируйте в .env и замените значения. Файл .env не коммитится (см. .gitignore).
# Здесь нет действующих секретов: все значения — заглушки.
# Файл читают и Docker Compose, и приложение (go run ./cmd/api из корня репозитория);
# переменная, заданная в команде запуска, приоритетнее значения из файла.

# MySQL (используются и контейнером mysql, и приложением)
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=tasks
MYSQL_USER=tasks
MYSQL_PASSWORD=change-me-db-password

# Секреты приложения: не менее 32 байт, случайные и разные.
# Пример генерации: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
CURSOR_SECRET=change-me-generate-another-one-with-openssl-rand

# MySQL и Redis. Порты используются везде: приложение на хосте, сервисы внутри Compose и
# публикация на хост. Хосты — для запуска на хосте (go run ./cmd/api); контейнеры api и migrate
# обращаются к сервисам по именам mysql и redis во внутренней сети Compose.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Порт API в Compose: контейнер слушает его и публикуется на нём же.
API_PORT=8080

# Необязательные настройки (показаны значения по умолчанию)
# BCRYPT_COST=12
# JWT_TTL=1h
# RATE_USER_PER_MINUTE=120
# RATE_USER_BURST=20
# RATE_AUTH_PER_MINUTE=60
# RATE_AUTH_BURST=20
# TRUST_PROXY_HEADERS=false   # true только за доверенным прокси: IP для лимита входа из X-Forwarded-For
# JWT_ISSUER=team-tasks-service
# JWT_AUDIENCE=team-tasks-api
# MYSQL_LOCK_WAIT=5s
# REQUEST_TIMEOUT=10s
# REDIS_TIMEOUT=100ms
# SHUTDOWN_TIMEOUT=10s
# BREAKER_FAILURES=5
# BREAKER_OPEN=30s
